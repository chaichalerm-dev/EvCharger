# Optional future REST API. The core demo does not require this value.
NEXT_PUBLIC_API_BASE_URL=

# Optional trusted deployment origin for future absolute social metadata.
NEXT_PUBLIC_APP_ORIGIN=

# Optional provider overrides. Defaults use public educational/demo endpoints.
NEXT_PUBLIC_NOMINATIM_ENDPOINT=https://nominatim.openstreetmap.org/search
NEXT_PUBLIC_OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
NEXT_PUBLIC_OPEN_METEO_BASE_URL=https://api.open-meteo.com
NEXT_PUBLIC_OPEN_METEO_FLOOD_BASE_URL=https://flood-api.open-meteo.com
NEXT_PUBLIC_OPEN_METEO_ELEVATION_BASE_URL=https://api.open-meteo.com

# Optional MapTiler free-plan/evaluation key. Never commit a real key.
# Restrict browser keys to approved deployment domains in the provider console.
NEXT_PUBLIC_MAPTILER_KEY=
